{
  "name": "@casualbot/jest-sonar-reporter",
  "version": "2.6.0",
  "description": "A Sonar test reporter for Jest.",
  "keywords": [
    "sonar",
    "sonarqube",
    "jest",
    "reporter",
    "processor",
    "test",
    "jest reporter",
    "jest sonar reporter",
    "sonarcloud",
    "javascript",
    "typescript"
  ],
  "main": "lib/index.js",
  "files": [
    "lib",
    "lib/src"
  ],
  "scripts": {
    "test": "tsc --module commonjs && jest",
    "test:watch": "jest --watch",
    "test:coverage": "tsc --module commonjs && jest --coverage",
    "build": "tsc --module commonjs",
    "lint": "eslint . -c .eslintrc.js --quiet",
    "lint:coverage": "eslint . -c .eslintrc.js -f json-relative -o ./coverage/eslint.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CasualBot/jest-sonar-reporter.git"
  },
  "author": "Shawn Bernard <casualbotdev@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CasualBot/jest-sonar-reporter/issues"
  },
  "homepage": "https://github.com/CasualBot/jest-sonar-reporter#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7",
    "@babel/core": "^7",
    "@babel/plugin-transform-modules-commonjs": "^7",
    "@babel/plugin-transform-typescript": "^7",
    "@babel/preset-env": "^7",
    "@babel/preset-typescript": "^7",
    "@types/jest": "^29",
    "@types/mkdirp": "^2",
    "@types/node": "^24",
    "@types/uuid": "^10",
    "@types/xml": "^1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^29",
    "eslint": "^8",
    "eslint-config-prettier": "^9",
    "eslint-formatter-json-relative": "^0.1.0",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jest": "^28",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react": "^7",
    "jest": "^29",
    "prettier": "^3",
    "strip-ansi": "^7",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "dependencies": {
    "mkdirp": "^3",
    "uuid": "^11",
    "xml": "^1"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1"
  }
}
